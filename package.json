{
  "name": "sketchup-factory",
  "version": "0.1.0",
  "description": "SketchUp Factory: Claude Code agents in parallel on the SketchUp repos from a conversational web UI (a fork of FF Factory)",
  "scripts": {
    "start": "node server/index.ts",
    "dev": "node --watch server/index.ts",
    "typecheck": "tsc -p .",
    "build": "cd web && npm ci && npm run build",
    "setup": "node server/setup.ts",
    "voice-setup": "node server/voiceSetup.ts",
    "test": "node --test server/*.test.ts scripts/*.test.ts",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=**/*.test.ts --test-coverage-exclude=e2e/** --test-coverage-exclude=node_modules/** server/*.test.ts scripts/*.test.ts",
    "test:e2e": "playwright test",
    "release": "node scripts/release.ts"
  },
  "type": "module",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.284",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "web-push": "^3.6.7",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "typescript": "^7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=23.6"
  }
}

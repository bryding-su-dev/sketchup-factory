# No trailing slash: node_modules may be a symlink to a shared install, which "node_modules/" (directories only) never matched.
node_modules
web/dist/
data/
config.json
*.log
.DS_Store
__pycache__/
*.pyc
local-handoff.md
test-results/
playwright-report/
coverage/
# Visual baselines are CI's Linux renders; local ones stay local.
e2e/__screenshots__/**/*-win32.png
e2e/__screenshots__/**/*-darwin.png
# config.json's earlier versions (server/durable.ts) and the copy setAppConfig keeps
config.json.*
